{
  "about": "Applying the FOV value and the stored tweaks to a whole gameinfo.gi. previousFov is the value read before applying. Text fields are arrays of lines joined with LF. Unless a case says otherwise, every case with text input also runs with each LF replaced by CRLF in both input and expected output, and every case runs a second time on its own output, which must change nothing.",
  "cases": [
    {
      "name": "an existing value is updated",
      "input": [
        "\"GameInfo\"",
        "{",
        "\tgame \t\"citadel\"",
        "",
        "\tConVars",
        "\t{",
        "\t\t\"r_aspectratio\" \"2.3\"",
        "\t\t\"rate\"",
        "\t\t{",
        "\t\t\t\"min\"\t\t\"98304\"",
        "\t\t\t\"default\"\t\"786432\"",
        "\t\t}",
        "\t\t\"fps_max\"\t\"400\"",
        "\t}",
        "",
        "\tMemory",
        "\t{",
        "\t\t\"Foo\" \"1\"",
        "\t}",
        "}",
        ""
      ],
      "fov": "2",
      "convars": [],
      "scenesystem": [],
      "applyTweaks": true,
      "expected": {
        "changed": true,
        "previousFov": "2.3",
        "output": [
          "\"GameInfo\"",
          "{",
          "\tgame \t\"citadel\"",
          "",
          "\tConVars",
          "\t{",
          "\t\t\"r_aspectratio\" \"2\"",
          "\t\t\"rate\"",
          "\t\t{",
          "\t\t\t\"min\"\t\t\"98304\"",
          "\t\t\t\"default\"\t\"786432\"",
          "\t\t}",
          "\t\t\"fps_max\"\t\"400\"",
          "\t}",
          "",
          "\tMemory",
          "\t{",
          "\t\t\"Foo\" \"1\"",
          "\t}",
          "}",
          ""
        ],
        "convars": [
          [
            "r_aspectratio",
            "updated"
          ]
        ],
        "scenesystem": []
      }
    },
    {
      "name": "a correct value is not written",
      "input": [
        "\"GameInfo\"",
        "{",
        "\tgame \t\"citadel\"",
        "",
        "\tConVars",
        "\t{",
        "\t\t\"r_aspectratio\" \"2.3\"",
        "\t\t\"rate\"",
        "\t\t{",
        "\t\t\t\"min\"\t\t\"98304\"",
        "\t\t\t\"default\"\t\"786432\"",
        "\t\t}",
        "\t\t\"fps_max\"\t\"400\"",
        "\t}",
        "",
