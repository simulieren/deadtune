          "\t{",
          "\t\t\"cl_new\"\t\"1\"",
          "",
          "\t\t\"r_aspectratio\" \"2.83\"",
          "\t\t\"r_directlighting\" \"0\"                 // keep this comment",
          "\t\t\"rate\"",
          "\t\t{",
          "\t\t\t\"default\"\t\"786432\"",
          "\t\t}",
          "\t}",
          "",
          "\tSceneSystem",
          "\t{",
          "\t\tVolumetricFog\t0",
          "",
          "\t\tGpuLightBinner 1",
          "\t\tCSMCascadeResolution 2048",
          "\t}",
          "}",
          ""
        ],
        "convars": [
          [
            "r_aspectratio",
            "updated"
          ],
          [
            "r_directlighting",
            "updated"
          ],
          [
            "cl_new",
            "added"
          ]
        ],
        "scenesystem": [
          [
            "VolumetricFog",
            "added"
          ]
        ]
      }
    },
