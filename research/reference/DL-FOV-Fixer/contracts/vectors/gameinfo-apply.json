        "\t}",
        "}",
        ""
      ],
      "fov": "2.3",
      "convars": [],
      "scenesystem": [],
      "applyTweaks": true,
      "expected": {
        "changed": false,
        "previousFov": "2.3",
        "output": [
          "\"GameInfo\"",
          "{",
          "\tgame \t\"citadel\"",
          "",
          "\tConVars",
          "\t{",
          "\t\t\"r_aspectratio\" \"2.3\"",
          "\t\t\"rate\"",
          "\t\t{",
          "\t\t\t\"min\"\t\t\"98304\"",
          "\t\t\t\"default\"\t\"786432\"",
          "\t\t}",
          "\t\t\"fps_max\"\t\"400\"",
          "\t}",
          "",
          "\tMemory",
          "\t{",
          "\t\t\"Foo\" \"1\"",
          "\t}",
          "}",
          ""
        ],
        "convars": [
          [
            "r_aspectratio",
            "updated"
          ]
        ],
        "scenesystem": []
      }
    },
