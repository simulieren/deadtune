<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>DlFovFixer.Core.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DlFovFixer.Core\DlFovFixer.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- The shared behavior vectors, read by these tests and by the Python tests alike. -->
  <ItemGroup>
    <None Include="$(RepositoryRoot)contracts\vectors\*.json"
          Link="vectors\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- xUnit v3 on Microsoft.Testing.Platform (global.json). -->
    <PackageReference Include="xunit.v3" Version="4.0.1" />
  </ItemGroup>
</Project>
